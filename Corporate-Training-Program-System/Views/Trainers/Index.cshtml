@model IEnumerable<Corporate_Training_Program_System.Models.Trainer>

<h2>Trainers</h2>

<a class="btn btn-primary mb-3" asp-action="Create">Add Trainer</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Specialization</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.FirstName @t.LastName</td>
                <td>@t.Specialization</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@t.TrainerId">Details</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@t.TrainerId">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@t.TrainerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
