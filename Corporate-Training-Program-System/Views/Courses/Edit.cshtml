@model Corporate_Training_Program_System.Models.ViewModels.CourseEditViewModel

<h2>Edit Course</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="CourseId" />

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="Duration"></label>
        <input asp-for="Duration" class="form-control" />
        <span asp-validation-for="Duration" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="TrainerId"></label>
        <select asp-for="TrainerId" asp-items="ViewBag.Trainers" class="form-control"></select>
        <span asp-validation-for="TrainerId" class="text-danger"></span>
    </div>

    <button class="btn btn-primary mt-3" type="submit">Save</button>
</form>
