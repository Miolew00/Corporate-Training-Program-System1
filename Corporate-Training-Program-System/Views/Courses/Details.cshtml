@model Corporate_Training_Program_System.Models.ViewModels.CourseDetailsViewModel

<h2>@Model.Title</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model.Enrollments)
        {
            <tr>
                <td>@e.EmployeeName</td>
                <td>@e.EnrolledOn.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>
