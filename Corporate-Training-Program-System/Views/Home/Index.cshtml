@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-box">
    <h1 style="text-align:center; margin-bottom:30px;">Dashboard</h1>

    <div class="row" style="margin-top:20px;">

        <div class="col-md-3">
            <a href="/Employees" class="dashboard-card">
                <h3>Employees</h3>
                <p>Manage all employees</p>
            </a>
        </div>

        <div class="col-md-3">
            <a href="/Courses" class="dashboard-card">
                <h3>Courses</h3>
                <p>View and create courses</p>
            </a>
        </div>

        <div class="col-md-3">
            <a href="/Trainers" class="dashboard-card">
                <h3>Trainers</h3>
                <p>Manage course trainers</p>
            </a>
        </div>

        <div class="col-md-3">
            <a href="/Enrollments" class="dashboard-card">
                <h3>Enrollments</h3>
                <p>Assign employees to courses</p>
            </a>
        </div>

    </div>
</div>

<style>
    .dashboard-card {
        display: block;
        background: #161b22;
        border: 1px solid #30363d;
        padding: 25px;
        border-radius: 12px;
        text-align: center;
        color: white;
        text-decoration: none;
        margin-bottom: 20px;
        transition: 0.2s;
        box-shadow: 0 0 15px rgba(0,0,0,0.3);
    }

        .dashboard-card:hover {
            background: #1f242c;
            border-color: #58a6ff;
            transform: translateY(-3px);
        }

        .dashboard-card h3 {
            color: #58a6ff;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .dashboard-card p {
            font-weight: bold;
            opacity: 0.8;
        }
</style>
