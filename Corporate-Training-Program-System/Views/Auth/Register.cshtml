@{
    ViewData["Title"] = "Register";
}

<style>
    body {
        background: #0d1117;
        font-family: 'Segoe UI', sans-serif;
        color: white;
        font-weight: bold;
    }

    .auth-box {
        width: 420px;
        margin: 80px auto;
        background: #161b22;
        padding: 35px;
        border-radius: 12px;
        box-shadow: 0 0 25px rgba(0,0,0,0.6);
        border: 1px solid #30363d;
    }

        .auth-box h2 {
            text-align: center;
            margin-bottom: 25px;
            font-size: 32px;
            font-weight: 900;
            color: #58a6ff;
            letter-spacing: 2px;
        }

    .auth-input {
        background: #0d1117;
        border: 2px solid #30363d;
        color: white;
        padding: 12px;
        width: 100%;
        border-radius: 8px;
        margin-bottom: 18px;
        font-weight: bold;
    }

        .auth-input:focus {
            border-color: #58a6ff;
            outline: none;
        }

    .auth-btn {
        width: 100%;
        padding: 12px;
        background: #238636;
        border: none;
        border-radius: 8px;
        color: white;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
    }

        .auth-btn:hover {
            background: #2ea043;
        }

    .auth-link {
        display: block;
        text-align: center;
        margin-top: 15px;
        color: #58a6ff;
        font-weight: bold;
        text-decoration: none;
    }

        .auth-link:hover {
            text-decoration: underline;
        }

    .error {
        color: #ff6b6b;
        text-align: center;
        margin-top: 10px;
        font-weight: bold;
    }
</style>

<div class="auth-box">
    <h2>REGISTER</h2>

    <form method="post" asp-action="Register" asp-controller="Auth">
        <input name="email" class="auth-input" placeholder="Email" />
        <input name="password" type="password" class="auth-input" placeholder="Password" />

        <button class="auth-btn">Create Account</button>

        @if (ViewBag.Error != null)
        {
            <p class="error">@ViewBag.Error</p>
        }

        <a class="auth-link" asp-action="Login" asp-controller="Auth">Already have an account?</a>
    </form>
</div>
